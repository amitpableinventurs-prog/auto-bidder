generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  phone          String?         @unique
  name           String?
  avatarUrl      String?
  address        String?
  city           String?
  zipCode        String?
  isVerified     Boolean         @default(false)
  isFeatured     Boolean         @default(false)
  kycStatus      String?         @default("PENDING")
  kycImageUrl    String?
  role           Role            @default(BUYER)
  userType       String?         @default("BUYER")
  businessName   String?
  createdAt      DateTime        @default(now())
  appointments   Appointment[]
  autoBidConfigs AutoBidConfig[]
  bids           Bid[]
  dnpProfile     DNPProfile?
  favorites      Favorite[]
  listings       Listing[]
  notifications  Notification[]
  pushTokens     PushToken[]

  @@index([email])
  @@index([phone])
}

model OTP {
  id           String   @id @default(cuid())
  email        String   @unique
  hashedCode   String
  expiresAt    DateTime
  attempts     Int      @default(0)
  lastResentAt DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([email])
}

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  listingId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
}

model Listing {
  id                      String            @id @default(cuid())
  title                   String
  description             String?
  brand                   String?
  model                   String?
  variant                 String?
  manufacturingYear       Int?
  fuelType                String?
  transmission            String?
  carType                 String?
  color                   String?
  city                    String?
  latitude                Float?
  longitude               Float?
  plateNumber             String?
  ownership               String?
  kilometersDriven        Int?
  condition               String?
  demandPrice             Int?
  startingBid             Int
  imageUrl                String?
  images                  Json?
  rcImages                Json?
  invoiceImages           Json?
  bankNocImages           Json?
  rcOwnerName             String?
  rcOwnerNumber           String?
  rcAvailability          String?
  originalInvoice         Boolean?          @default(true)
  bankHypothecation       Boolean?          @default(false)
  loanStatus              String?
  rtoTaxStatus            String?
  rtoNocIssued            String?
  rtoNocNumber            String?
  rtoIssues               String?
  duplicateKeys           Boolean?          @default(false)
  serviceBookAvailability Boolean?          @default(true)
  remainingFreeService    Int?              @default(0)
  remainingOemWarranty    String?
  insuranceType           String?
  insuranceExpiry         String?
  registrationDate        String?
  listedBy                String?
  sellerContactName       String?
  sellerContactNumber     String?
  sellingTimeline         String?
  ownershipType           String?
  cngLpgStatus            String?
  rtoNocFor               String?
  accidentalHistory       String?
  commission              String?
  inspectionReportUrl     String?
  inspectionReportStatus  String?           @default("PENDING")
  status                  ListingStatus     @default(DRAFT)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  sellerId                String
  appointments            Appointment[]
  autoBidConfigs          AutoBidConfig[]
  bids                    Bid[]
  commissions             DNPCommission[]
  sharedListings          DNPListingShare[]
  referrals               DNPVehicleLead?
  favorites               Favorite[]
  seller                  User              @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  payments                Payment?
  rtoNoc                  RtoNoc?

  @@index([createdAt])
  @@index([status, city])
  @@index([brand, model])
  @@index([transmission, fuelType])
  @@index([carType])
  @@index([demandPrice])
}

model Bid {
  id              String         @id @default(cuid())
  amount          Int
  status          BidStatus      @default(SUBMITTED)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  listingId       String
  userId          String
  autoBidConfigId String?
  listing         Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  autoBidConfig   AutoBidConfig? @relation(fields: [autoBidConfigId], references: [id], onDelete: SetNull)
  payment         Payment?

  @@index([listingId, createdAt])
  @@index([userId, status])
  @@index([autoBidConfigId])
  @@index([amount])
}

model Appointment {
  id          String            @id @default(cuid())
  type        AppointmentType
  status      AppointmentStatus @default(PENDING)
  scheduledAt DateTime?
  location    String?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  listingId   String
  userId      String
  listing     Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([listingId, scheduledAt])
  @@index([userId, status])
}

model RtoNoc {
  id            String    @id @default(cuid())
  rtoTaxStatus  String?
  rtoDues       String?
  rtoNocIssued  String?
  bankNocStatus NocStatus @default(NOT_STARTED)
  rtoNocStatus  NocStatus @default(NOT_STARTED)
  invoiceStatus NocStatus @default(NOT_STARTED)
  ownerIdStatus NocStatus @default(NOT_STARTED)
  uploadedCount Int       @default(0)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  listingId     String    @unique
  listing       Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Payment {
  id                    String        @id @default(cuid())
  amount                Int
  currency              String        @default("INR")
  status                PaymentStatus @default(PENDING)
  stripePaymentIntentId String?       @unique
  stripeClientSecret    String?
  metadata              Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  bidId                 String?       @unique
  listingId             String?       @unique
  bid                   Bid?          @relation(fields: [bidId], references: [id], onDelete: Cascade)
  listing               Listing?      @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([bidId])
  @@index([listingId])
}

model AutoBidConfig {
  id        String   @id @default(cuid())
  maxLimit  Int
  increment Int      @default(5000)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  listingId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bids      Bid[]

  @@unique([userId, listingId])
  @@index([listingId, isActive])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  data      Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
  @@index([type])
}

model PushToken {
  id        String   @id @default(cuid())
  token     String   @unique
  platform  String   @default("android")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([token])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  adminName String?
  target    String?
  details   Json?
  timestamp DateTime @default(now())

  @@index([timestamp])
  @@index([action])
}

model FraudAlert {
  id          String   @id @default(cuid())
  severity    String   @default("MEDIUM")
  type        String
  description String
  userId      String?
  userName    String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model Slider {
  id        String   @id @default(cuid())
  type      String   @default("HOME")
  title     String
  subtitle  String?
  imageUrl  String
  videoUrl  String?
  mediaType String   @default("IMAGE")
  link      String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Brand {
  id          String   @id @default(cuid())
  name        String   @unique
  logo        String
  count       String   @default("0 Cars")
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Collection {
  id        String   @id @default(cuid())
  name      String   @unique
  imageUrl  String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model News {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  content     String?
  link        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DNPProfile {
  id                   String                   @id @default(cuid())
  userId               String                   @unique
  referralCode         String                   @unique
  referralLink         String
  status               DNPStatus                @default(INACTIVE)
  activationDate       DateTime?
  isSuspicious         Boolean                  @default(false)
  suspiciousReason     String?
  totalEarnings        Int                      @default(0)
  pendingEarnings      Int                      @default(0)
  approvedEarnings     Int                      @default(0)
  paidEarnings         Int                      @default(0)
  availableBalance     Int                      @default(0)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  agreementAcceptances DNPAgreementAcceptance[]
  auditLogs            DNPAuditLog[]
  commissions          DNPCommission[]
  listingShares        DNPListingShare[]
  membershipRecoveries DNPMembershipRecovery[]
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleLeads         DNPVehicleLead[]
  walletLedgers        DNPWalletLedger[]
  withdrawalRequests   DNPWithdrawalRequest[]

  @@index([userId])
  @@index([referralCode])
  @@index([status])
}

model DNPAgreementAcceptance {
  id               String     @id @default(cuid())
  dnpProfileId     String
  agreementVersion String
  termsVersion     String
  acceptedAt       DateTime   @default(now())
  ipAddress        String?
  createdAt        DateTime   @default(now())
  dnpProfile       DNPProfile @relation(fields: [dnpProfileId], references: [id], onDelete: Cascade)

  @@index([dnpProfileId])
}

model DNPMembershipRecovery {
  id              String            @id @default(cuid())
  dnpProfileId    String
  membershipYear  Int
  totalFee        Int               @default(5000)
  recoveredAmount Int               @default(0)
  status          RecoveryStatus    @default(NOT_STARTED)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  dnpProfile      DNPProfile        @relation(fields: [dnpProfileId], references: [id], onDelete: Cascade)
  ledgerEntries   DNPWalletLedger[]

  @@index([dnpProfileId])
  @@index([status])
}

model DNPVehicleLead {
  id                   String                 @id @default(cuid())
  dnpProfileId         String
  sellerName           String
  sellerPhone          String
  sellerEmail          String?
  sellerCity           String
  preferredContactTime String?
  brand                String
  model                String
  variant              String
  year                 Int
  regNumber            String
  fuelType             String
  transmission         String
  kmsDriven            Int
  expectedPrice        Int
  location             String
  images               String?
  notes                String?
  status               VehicleLeadStatus      @default(SUBMITTED)
  listingId            String?                @unique
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  commissions          DNPCommission[]
  statusHistory        DNPLeadStatusHistory[]
  listing              Listing?               @relation(fields: [listingId], references: [id])
  dnpProfile           DNPProfile             @relation(fields: [dnpProfileId], references: [id], onDelete: Cascade)

  @@index([dnpProfileId])
  @@index([status])
  @@index([regNumber])
}

model DNPListingShare {
  id           String         @id @default(cuid())
  dnpProfileId String
  listingId    String
  shareToken   String         @unique
  shareMethod  String?
  createdAt    DateTime       @default(now())
  expiresAt    DateTime?
  buyerLeads   DNPBuyerLead[]
  listing      Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  dnpProfile   DNPProfile     @relation(fields: [dnpProfileId], references: [id], onDelete: Cascade)

  @@index([dnpProfileId])
  @@index([listingId])
}

model DNPBuyerLead {
  id             String                 @id @default(cuid())
  listingShareId String
  buyerName      String
  buyerPhone     String
  buyerEmail     String?
  city           String?
  budget         Int?
  notes          String?
  status         BuyerLeadStatus        @default(SHARED)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  listingShare   DNPListingShare        @relation(fields: [listingShareId], references: [id], onDelete: Cascade)
  commissions    DNPCommission[]
  statusHistory  DNPLeadStatusHistory[]

  @@index([listingShareId])
  @@index([status])
  @@index([buyerPhone])
}

model DNPLeadStatusHistory {
  id            String          @id @default(cuid())
  vehicleLeadId String?
  buyerLeadId   String?
  status        String
  notes         String?
  changedBy     String?
  createdAt     DateTime        @default(now())
  buyerLead     DNPBuyerLead?   @relation(fields: [buyerLeadId], references: [id], onDelete: Cascade)
  vehicleLead   DNPVehicleLead? @relation(fields: [vehicleLeadId], references: [id], onDelete: Cascade)

  @@index([vehicleLeadId])
  @@index([buyerLeadId])
}

model DNPCommission {
  id            String           @id @default(cuid())
  dnpProfileId  String
  vehicleLeadId String?
  buyerLeadId   String?
  listingId     String?
  amount        Int
  status        CommissionStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  listing       Listing?         @relation(fields: [listingId], references: [id])
  buyerLead     DNPBuyerLead?    @relation(fields: [buyerLeadId], references: [id])
  vehicleLead   DNPVehicleLead?  @relation(fields: [vehicleLeadId], references: [id])
  dnpProfile    DNPProfile       @relation(fields: [dnpProfileId], references: [id], onDelete: Cascade)

  @@index([dnpProfileId])
  @@index([status])
}

model DNPCommissionRule {
  id         String   @id @default(cuid())
  name       String
  type       String
  flatAmount Int?
  percentage Float?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DNPConfig {
  id                     String   @id @default("default")
  membershipFee          Int      @default(5000)
  recoveryPercentage     Float    @default(100)
  maxDeductionPerEarning Int?
  minEarningThreshold    Int      @default(0)
  updatedAt              DateTime @updatedAt
}

model DNPWalletLedger {
  id                   String                 @id @default(cuid())
  dnpProfileId         String
  type                 WalletTransactionType
  amount               Int
  balanceAfter         Int
  description          String?
  referenceId          String?
  membershipRecoveryId String?
  createdAt            DateTime               @default(now())
  membershipRecovery   DNPMembershipRecovery? @relation(fields: [membershipRecoveryId], references: [id])
  dnpProfile           DNPProfile             @relation(fields: [dnpProfileId], references: [id], onDelete: Cascade)

  @@index([dnpProfileId])
  @@index([type])
}

model DNPWithdrawalRequest {
  id           String           @id @default(cuid())
  dnpProfileId String
  amount       Int
  status       WithdrawalStatus @default(PENDING)
  adminNotes   String?
  processedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  dnpProfile   DNPProfile       @relation(fields: [dnpProfileId], references: [id], onDelete: Cascade)

  @@index([dnpProfileId])
  @@index([status])
}

model DNPAuditLog {
  id           String     @id @default(cuid())
  dnpProfileId String
  action       String
  details      String?
  ipAddress    String?
  createdAt    DateTime   @default(now())
  dnpProfile   DNPProfile @relation(fields: [dnpProfileId], references: [id], onDelete: Cascade)

  @@index([dnpProfileId])
  @@index([action])
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum ListingStatus {
  DRAFT
  PENDING_INSPECTION
  ACTIVE
  SOLD
  REJECTED
}

enum BidStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  SUPERSEDED
}

enum AppointmentType {
  BUYER_INSPECTION
  AUTOBIDDER_INSPECTION
  AUTHORIZED_CENTER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum NocStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  REQUIRES_ACTION
  FAILED
  CANCELLED
}

enum NotificationType {
  OUTBID
  BID_ACCEPTED
  BID_REJECTED
  PAYMENT_CONFIRMED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  AUTO_BID_TRIGGERED
  LISTING_SOLD
  SYSTEM
  DNP_ACTIVATED
  DNP_LEAD_UPDATE
  DNP_COMMISSION
  DNP_WITHDRAWAL
}

enum DNPStatus {
  INACTIVE
  ELIGIBLE
  PENDING_AGREEMENT
  ACTIVE
  SUSPENDED
  REJECTED
  DEACTIVATED
}

enum RecoveryStatus {
  NOT_STARTED
  PARTIALLY_RECOVERED
  FULLY_RECOVERED
  WAIVED
  PAUSED
}

enum VehicleLeadStatus {
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  LISTING_CREATED
  APPROVED
  ELIGIBLE
  COMMISSION_PENDING
  COMMISSION_APPROVED
  PAID
  REJECTED
  DUPLICATE
  CANCELLED
  EXPIRED
}

enum BuyerLeadStatus {
  DRAFT
  SHARED
  VIEWED
  INTERESTED
  CONTACTED
  NEGOTIATION
  TEST_DRIVE
  CONVERTED
  LOST
  CANCELLED
  EXPIRED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
  CANCELLED
}

enum WalletTransactionType {
  COMMISSION_PENDING
  COMMISSION_APPROVED
  COMMISSION_CREDITED
  MEMBERSHIP_FEE_RECOVERY
  WITHDRAWAL_REQUESTED
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  WITHDRAWAL_PAID
  ADJUSTMENT
  REVERSAL
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  CANCELLED
}
