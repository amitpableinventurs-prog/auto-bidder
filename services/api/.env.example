PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://your-app-domain.com
ADMIN_EMAIL=admin@autobidder.in
ADMIN_PASSWORD=change-this-admin-password
DATABASE_URL=\"postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[AWS_REGION].pooler.supabase.com:6543/postgres?pgbouncer=true\"
AUTO_BIDDER_STORE=\"database\"

# Optional for Pusher Realtime (if using Supabase Pusher compat)
PUSHER_APP_ID=your-app-id
PUSHER_KEY=your-pusher-publishable-key
PUSHER_SECRET=your-pusher-secret-key
PUSHER_CLUSTER=mt1
PUSHER_HOST=your-project-ref.supabase.co
PUSHER_PORT=443
PUSHER_USE_TLS=true

# Copy this to .env and replace with your Supabase details from Dashboard > Settings > Database
