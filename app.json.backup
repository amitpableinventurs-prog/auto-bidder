{
  "expo": {
    "name": "auto-bidder",
    "slug": "auto-bidder",
    "version": "1.0.0",
    "scheme": "autobidder",
    "android": {
      "package": "in.autobidder.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Auto Bidder to use the camera to capture car photos for listings."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Auto Bidder to use your location to find cars and auctions near you."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.autobidder",
          "enableGooglePay": true
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Auto Bidder to use the camera to capture car photos for listings."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": false,
            "compileSdkVersion": 36,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "ndkVersion": "26.3.11579264"
          }
        }
      ],
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "dd46b85b-768e-4574-b453-397a67d4b22a"
      }
    },
    "owner": "monicinfosys"
  }
}
