{
  "expo": {
    "name": "Auto Bidder",
    "slug": "auto-bidder-mobile",
    "scheme": "auto-bidder",
    "version": "1.0.0",
    "description": "AutoBidder - Premium Car Auction Marketplace",
    "owner": "autobidder",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.autobidder.mobile",
      "associatedDomains": [
        "applinks:api.autobidder.in"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "android": {
      "package": "com.autobidder.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-notifications",
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": false,
            "minSdkVersion": 24,
            "targetSdkVersion": 35,
            "compileSdkVersion": 36,
            "ndkVersion": "26.1.10909125"
          }
        }
      ],
      "expo-sharing",
      "expo-video"
    ]
  }
}
