{
  "expo": {
    "name": "auto-bidder",
    "slug": "auto-bidder",
    "version": "1.0.0",
    "scheme": "autobidder",
    "android": {
      "package": "com.anonymous.autobidder",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Auto Bidder to use the camera to capture car photos for listings."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Auto Bidder to use your location to find cars and auctions near you."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.autobidder",
          "enableGooglePay": true
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Auto Bidder to use the camera to capture car photos for listings."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": false
          }
        }
      ],
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "56841596-4ad6-409f-8eea-f4f4cd39efdc"
      }
    },
    "owner": "vs0"
  }
}
